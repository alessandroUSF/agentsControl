# Copy to .env and fill in yourself. Never commit .env.
# Keys of the SEPARATE research accounts only (never the main accounts).
# The runner reads only these names and never falls back to ANTHROPIC_API_KEY / OPENAI_API_KEY.
AC_ANTHROPIC_API_KEY=
AC_OPENAI_API_KEY=
# hard spending cap for one run, in US dollars (the runner stops before crossing it)
BUDGET_USD=5
