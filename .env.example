# Copy to .env and fill it in yourself. Never commit .env.
# Protocol v2.3, Section 16.4: keys of the research accounts opened for this study only.
# The code accepts only variables whose names start with AC_ and never falls back to
# ANTHROPIC_API_KEY, OPENAI_API_KEY or any other key.

# Anthropic research account: models 1 and 2 of the commercial panel.
AC_ANTHROPIC_API_KEY=
# OpenAI research account: models 3, 9 and 11 of the commercial panel.
AC_OPENAI_API_KEY=
# Google research account (Gemini API), opened for model 14 (decision D2). Not used since model 14
# left the study (decision D17, 12 November 2026); no model calls it, and the line may stay empty.
AC_GOOGLE_API_KEY=
# OpenRouter research account: every other API model (7, 8, 10, 12, 13) and models 22 and 23 of
# the primary panel. Endpoints that neither retain nor train only (Section 16.4).
AC_OPENROUTER_API_KEY=

# How much each account needs: protocol Section 12 and analysis/output/manifest_v23.json
# (per_provider). Pessimistic totals since decision D17 (12 November 2026), in US dollars:
# Anthropic 23.75, OpenAI 23.33, OpenRouter 54.95. They are priced again after the pilot.
# The accounts together must not be able to spend more than the cap below. Fees and taxes
# on credit purchases count against the cap (Section 12.4).

# Hard cap for one run, in US dollars. Required for every run that calls an API model.
BUDGET_USD=5
# The cap for the whole study is US$128 (decision D14, Section 12.4). It is fixed in src/spend_v23.py and
# needs no line here; if STUDY_BUDGET_USD is set, it must be 128, or every paid run stops.
# Fees and taxes paid on credit purchases are recorded in the ledger before the next paid call:
#   python -I src/spend_v23.py fee --usd <amount> --account <anthropic|openai|google|openrouter> --note "<what>"
# They count against the cap there; do not lower the cap for them.

# The OSF account used for the registrations is a website account. Nothing goes here for it.
