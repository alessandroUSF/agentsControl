# secrets: API keys live only in .env (never committed)
.env
# raw benchmark files are re-downloaded by scripts/fetch_data.py
data/raw/
data/processed/
# everything under results/ stays private (protocol v2.3, Section 16.7; README, Responsible design):
# - raw model answers may contain harmful text and are never published
# - verdict files hold judge reasons, which may paraphrase harmful answers
# - call logs are published only as a reviewed copy, without answer text and raw error bodies
results/
# labelling sheets hold answer text, and label files are private until the release:
# only the rubric is tracked
labels/*
!labels/RUBRIC.md
# internal working notes
docs/PLANO.md
__pycache__/
.venv/
*.pyc
